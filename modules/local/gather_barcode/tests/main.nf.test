nextflow_process {

    name "Test Process GATHER_BARCODE"
    script "../main.nf"
    process "GATHER_BARCODE"

    test("test_LARRY.umi_extract_2.fastq.gz [fastq.gz]") {

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [id : 'test' , single_end : true], 
                    [file("${projectDir}/data/fastq/test_LARRY.umi_extract_2.fastq.gz", checkIfExists: true)]
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
