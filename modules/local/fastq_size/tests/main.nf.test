nextflow_process {

    name "Test Process FASTQ_SIZE"
    script "../main.nf"
    process "FASTQ_SIZE"

    test("fastq_size [fastq.gz]") {

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    file("${projectDir}/data/fastq/fastq_size.fastq.gz")
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
