nextflow_process {

    name "Test Process UNIQUE"
    script "../main.nf"
    process "UNIQUE"

    test("test_GEX.tsv [tsv]") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    file("${projectDir}/data/tsv/test_GEX.tsv")
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
