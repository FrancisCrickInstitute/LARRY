/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    // Base directory for nf-core/modules test data
    modules_testdata_base_path = 's3://ngi-igenomes/testdata/nf-core/modules/'

    // Input csv
    input        = "${projectDir}/input/test/input.csv"

    // Output directory
    outdir = "${projectDir}/output/test"

    // Reference file
    cellranger_reference = "${projectDir}/input/test/cellranger_reference"

}